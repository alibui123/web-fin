# Copy this file to .env.local for local development.
# In production, add each of these in the Vercel dashboard:
# Project Settings > Environment Variables.

# --- Database (Prisma) ---
# Postgres connection string used by Prisma Client at runtime (pooled connection,
# e.g. via PgBouncer/Prisma Accelerate). Required for consultation-booking storage;
# the app degrades gracefully (booking writes fail, reads return empty) if unset.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Direct (non-pooled) Postgres connection string, used by Prisma for migrations
# (`prisma migrate`) which cannot run through a connection pooler.
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Retell AI (voice call widget) ---
# Server-side API key for Retell AI, used in app/api/create-web-call/route.ts.
RETELL_API_KEY="your-retell-api-key"

# Retell AI agent ID to place the web call against, used in the same route.
RETELL_AGENT_ID="your-retell-agent-id"

# Public URL of the Retell worker, exposed to the browser (NEXT_PUBLIC_ prefix).
# Used in components/hero-cta.tsx.
NEXT_PUBLIC_RETELL_WORKER_URL="https://your-retell-worker.example.com"

# --- Calendly ---
# Public Calendly scheduling link, exposed to the browser. Used in
# components/consultation-booking.tsx.
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-org/consultation"

# --- Build mode (optional, not a secret) ---
# Set to "export" only if you need a static export build (next build && next export).
# Leave unset for the default Next.js server build used by Vercel deployments.
# NEXT_OUTPUT_MODE=
